# Copiar a .env y completar con valores reales (sin comillas).
# Si el envío falla con 401, genera un token nuevo en Meta.

# Meta → WhatsApp → API Setup → Access token
WHATSAPP_TOKEN=

# El mismo string que configures en Webhook → Verify token
WHATSAPP_VERIFY_TOKEN=

# Meta → API Setup → Phone number ID (número largo, no el +1...)
PHONE_NUMBER_ID=

DATABASE_PATH=invoices.db
