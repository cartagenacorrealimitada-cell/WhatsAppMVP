# Copiar a .env y completar con valores reales (sin comillas).
# Guía: docs/despliegue.md

# Token PERMANENTE (System User en Meta Business). NO uses el token temporal de API Setup.
WHATSAPP_TOKEN=

# El mismo string que configures en Webhook → Verify token
WHATSAPP_VERIFY_TOKEN=

# Meta → API Setup → Phone number ID (número largo, no el +1...)
PHONE_NUMBER_ID=

# Dominio ngrok fijo (Callback = PUBLIC_BASE_URL + /webhook)
PUBLIC_BASE_URL=https://backyard-overture-schilling.ngrok-free.dev

DATABASE_PATH=invoices.db

# Secreto para confirmar pagos (Authorization: Bearer … o X-QRDNT-Payments-Token)
# Obligatorio en producción. El lunes se sumará el mecanismo del proveedor.
PAYMENTS_CONFIRM_TOKEN=
